# Copy to .env.local (ignored by git) and fill in.

# Postgres connection string, e.g. from Neon, Supabase, Render, Railway or your own server.
DATABASE_URL=postgres://user:password@localhost:5432/steelbase

# Password for /admin (at least 12 characters). Admin is switched off when unset.
ADMIN_PASSWORD=

# Public address of the site, used for the sitemap and link previews. Must be set
# when building. On Vercel it defaults to the project's production domain.
SITE_URL=https://example.com
